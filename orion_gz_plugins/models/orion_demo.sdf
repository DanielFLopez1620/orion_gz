<?xml version="1.0"?>
<!--
  orion_demo.sdf
  Minimal standalone world for testing both GZ plugins without the full ORION
  simulation stack.

  Features:
    - EmotionDisplayPlugin loaded on the orion_demo model.
      Publish a number 0-7 to test:
        gz topic -t /emotion/int -m gz.msgs.Int32 -p "data: 3"

    - TouchSensorPlugin loaded in the <gui> section.
      Left-click on any blue sensor box. Listen with:
        gz topic -e -t /interaction/touch_ul

  Plugin library paths must be on GZ_SIM_SYSTEM_PLUGIN_PATH (system plugin)
  and GZ_GUI_PLUGIN_PATH (GUI plugin), or set via the environment before
  launching:
    export GZ_SIM_SYSTEM_PLUGIN_PATH=<install>/lib:$GZ_SIM_SYSTEM_PLUGIN_PATH
    export GZ_GUI_PLUGIN_PATH=<install>/lib:$GZ_GUI_PLUGIN_PATH
-->
<sdf version="1.9">
  <world name="orion_plugin_demo">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      ═══════════════════════════════════════════════════════════════════════
      ORION DEMO MODEL
      Represents the ORION body with a "screen" link (emotion display) and
      four "touch_*" links (capacitive sensor zones).

      Adjust the mesh paths to point at the real ORION meshes once the full
      simulation is integrated.
      ═══════════════════════════════════════════════════════════════════════
    -->
    <model name="orion_demo">
      <static>true</static>
      <pose>0 0 0.3 0 0 0</pose>

      <!-- Body (placeholder box) -->
      <link name="body">
        <visual name="body_visual">
          <geometry><box><size>0.18 0.14 0.25</size></box></geometry>
          <material>
            <ambient>0.85 0.75 0.3 1</ambient>
            <diffuse>0.85 0.75 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="body_col">
          <geometry><box><size>0.18 0.14 0.25</size></box></geometry>
        </collision>
      </link>

      <!-- ── Emotion display screen ──────────────────────────────────────── -->
      <!-- Thin rectangle on the front face of the body (176×220 px → ~5×7 cm) -->
      <link name="screen">
        <pose>0 -0.072 0.03 0 0 0</pose>
        <visual name="screen_visual">
          <geometry><box><size>0.05 0.002 0.07</size></box></geometry>
          <material>
            <!-- Initial colour: neutral white (emotion 4) -->
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.25 0.25 0.25 1</emissive>
          </material>
        </visual>
      </link>
      <joint name="screen_joint" type="fixed">
        <parent>body</parent><child>screen</child>
      </joint>

      <!-- ── Touch sensor zones ─────────────────────────────────────────── -->
      <!-- Upper-left (top of body, left side) -->
      <link name="touch_ul">
        <pose>-0.055 0 0.11 0 0 0</pose>
        <visual name="touch_ul">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_ul_col">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_ul_joint" type="fixed">
        <parent>body</parent><child>touch_ul</child>
      </joint>

      <!-- Upper-right -->
      <link name="touch_ur">
        <pose>0.055 0 0.11 0 0 0</pose>
        <visual name="touch_ur">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_ur_col">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_ur_joint" type="fixed">
        <parent>body</parent><child>touch_ur</child>
      </joint>

      <!-- Lower-left (lateral, left side) -->
      <link name="touch_ll">
        <pose>-0.095 0 0 0 0 0</pose>
        <visual name="touch_ll">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_ll_col">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_ll_joint" type="fixed">
        <parent>body</parent><child>touch_ll</child>
      </joint>

      <!-- Lower-right (lateral, right side) -->
      <link name="touch_lr">
        <pose>0.095 0 0 0 0 0</pose>
        <visual name="touch_lr">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_lr_col">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_lr_joint" type="fixed">
        <parent>body</parent><child>touch_lr</child>
      </joint>

    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         GUI section: load the TouchSensorPlugin
         ═══════════════════════════════════════════════════════════════════ -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0 -1.5 1.0 0 0.4 1.5708</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
      </plugin>

      <!-- EmotionDisplayPlugin -->
      <plugin filename="libEmotionDisplayPlugin.so" name="EmotionDisplayPlugin">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">0</property>
          <property type="double" key="height">0</property>
        </gz-gui>
      </plugin>

      <!-- TouchSensorPlugin -->
      <plugin filename="libTouchSensorPlugin.so" name="TouchSensorPlugin">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <!-- width/height 0 → headless panel, no visual widget needed -->
          <property type="double" key="width">0</property>
          <property type="double" key="height">0</property>
        </gz-gui>
        <debounce_ms>250</debounce_ms>
      </plugin>
    </gui>

  </world>
</sdf>
