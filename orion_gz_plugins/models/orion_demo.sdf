<?xml version="1.0"?>
<!--
  orion_demo.sdf
  Minimal standalone world for testing both GZ plugins without the full ORION
  simulation stack.

  Features:
    - EmotionColorPlugin  : solid colour on "screen_color_visual" (no textures)
    - EmotionDisplayPlugin: face bitmap texture on "screen_visual"
    - TouchSensorPlugin   : left-click on any blue sensor box

  Publish an emotion (0-7) to test both plugins simultaneously:
    gz topic -t /emotion/int -m gz.msgs.Int32 -p "data: 3"

  Listen to touch sensors:
    gz topic -e -t /interaction/touch_ul

  Plugin library paths must be on GZ_GUI_PLUGIN_PATH before launching:
    export GZ_GUI_PLUGIN_PATH=<install>/lib:$GZ_GUI_PLUGIN_PATH
-->
<sdf version="1.9">
  <world name="orion_plugin_demo">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      ═══════════════════════════════════════════════════════════════════════
      ORION DEMO MODEL

      Screen assembly (landscape, matches rotated 220×176 px PNG output):

        screen_color → "screen_color_visual"  (0.060×0.012×0.044 m)
          Deeper prism for the EmotionColorPlugin solid-colour effect.
          Direct child of body, centred on the front face.

        screen → "screen_visual"              (0.055×0.002×0.040 m)
          Thin flat panel for the EmotionDisplayPlugin bitmap texture.
          Child of screen_color, centred on it and protruding 2 mm forward.
          Pose expressed relative to screen_color frame.
      ═══════════════════════════════════════════════════════════════════════
    -->
    <model name="orion_demo">
      <static>true</static>
      <pose>0 0 0.3 0 0 0</pose>

      <!-- Body (placeholder box) -->
      <link name="body">
        <visual name="body_visual">
          <geometry><box><size>0.18 0.14 0.25</size></box></geometry>
          <material>
            <ambient>0.85 0.75 0.3 1</ambient>
            <diffuse>0.85 0.75 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="body_col">
          <geometry><box><size>0.18 0.14 0.25</size></box></geometry>
        </collision>
      </link>

      <!-- ── Colour indicator (EmotionColorPlugin) — parent of screen ──── -->
      <!--
        Landscape prism: 60 mm wide × 12 mm deep × 44 mm tall.
        Body front face is at Y=−0.07; half-depth = 0.006 → centre at Y=−0.076.
      -->
      <link name="screen_color">
        <pose>0 -0.076 0.03 0 0 0</pose>
        <visual name="screen_color_visual">
          <geometry><box><size>0.060 0.012 0.044</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.25 0.25 0.25 1</emissive>
          </material>
        </visual>
      </link>
      <joint name="screen_color_joint" type="fixed">
        <parent>body</parent><child>screen_color</child>
      </joint>

      <!-- ── Texture screen (EmotionDisplayPlugin) — child of screen_color -->
      <!--
        Thin landscape panel: 55 mm wide × 2 mm deep × 40 mm tall.
        Pose relative to screen_color: Y=−0.007 places its front face 2 mm
        in front of screen_color's front face (−0.006 − 0.001 = −0.007 centre,
        front face at −0.008 vs screen_color front at −0.006 → 2 mm protrusion).
      -->
      <link name="screen">
        <pose relative_to="screen_color">0 -0.007 0 0 0 0</pose>
        <visual name="screen_visual">
          <geometry><box><size>0.055 0.002 0.040</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.15 0.15 0.15 1</emissive>
          </material>
        </visual>
      </link>
      <joint name="screen_joint" type="fixed">
        <parent>screen_color</parent><child>screen</child>
      </joint>

      <!-- ── Touch sensor zones ─────────────────────────────────────────── -->
      <!-- Upper-left -->
      <link name="touch_ul">
        <pose>-0.055 0 0.11 0 0 0</pose>
        <visual name="touch_ul">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_ul_col">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_ul_joint" type="fixed">
        <parent>body</parent><child>touch_ul</child>
      </joint>

      <!-- Upper-right -->
      <link name="touch_ur">
        <pose>0.055 0 0.11 0 0 0</pose>
        <visual name="touch_ur">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_ur_col">
          <geometry><box><size>0.03 0.03 0.004</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_ur_joint" type="fixed">
        <parent>body</parent><child>touch_ur</child>
      </joint>

      <!-- Lower-left (lateral) -->
      <link name="touch_ll">
        <pose>-0.095 0 0 0 0 0</pose>
        <visual name="touch_ll">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_ll_col">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_ll_joint" type="fixed">
        <parent>body</parent><child>touch_ll</child>
      </joint>

      <!-- Lower-right (lateral) -->
      <link name="touch_lr">
        <pose>0.095 0 0 0 0 0</pose>
        <visual name="touch_lr">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.2 0.6 1.0 0.7</ambient>
            <diffuse>0.2 0.6 1.0 0.7</diffuse>
            <emissive>0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <collision name="touch_lr_col">
          <geometry><box><size>0.004 0.03 0.03</size></box></geometry>
        </collision>
      </link>
      <joint name="touch_lr_joint" type="fixed">
        <parent>body</parent><child>touch_lr</child>
      </joint>

    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         GUI plugins
         ═══════════════════════════════════════════════════════════════════ -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0 -1.5 1.0 0 0.4 1.5708</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
      </plugin>

      <!-- EmotionColorPlugin: solid colour on screen_color_visual -->
      <plugin filename="libEmotionColorPlugin.so" name="EmotionColorPlugin">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">0</property>
          <property type="double" key="height">0</property>
        </gz-gui>
        <visual_name>screen_color_visual</visual_name>
      </plugin>

      <!-- EmotionDisplayPlugin: bitmap texture on screen_visual -->
      <plugin filename="libEmotionDisplayPlugin.so" name="EmotionDisplayPlugin">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">0</property>
          <property type="double" key="height">0</property>
        </gz-gui>
        <visual_name>screen_visual</visual_name>
      </plugin>

      <!-- TouchSensorPlugin -->
      <plugin filename="libTouchSensorPlugin.so" name="TouchSensorPlugin">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">0</property>
          <property type="double" key="height">0</property>
        </gz-gui>
        <debounce_ms>250</debounce_ms>
      </plugin>
    </gui>

  </world>
</sdf>
