{
    "name": "ORION GZ Dev Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "../../..",
        "args": {
            "USERNAME": "orion_user"
        }
    },
    "remoteUser": "orion_user",
    "privileged": true,
    "workspaceFolder": "/home/orion_user/ws/src/orion_gz",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/orion_user/ws/src/orion_gz,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "ms-python.python",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "containerEnv": {
        // Domain 16 keeps the simulation isolated from a real robot stack
        // (which uses 0 for the micro-ROS agent) running on the same host.
        "ROS_DOMAIN_ID": "16"
    },
    "runArgs": [
        "--network", "host",
        "-e", "DISPLAY=${env:DISPLAY}",
        "--group-add", "video",
        "--group-add", "audio"
        // "--gpus", "all"  ← enable once NVIDIA Container Toolkit is configured
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=${env:HOME}/.Xauthority,target=/home/orion_user/.Xauthority,type=bind"
    ],
    "postCreateCommand": "orion_gz_docker/dev/post_create.sh"
}
