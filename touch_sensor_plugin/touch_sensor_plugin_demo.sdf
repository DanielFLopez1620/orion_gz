<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!--
      System plugins can be loaded from <plugin> tags attached to entities like
      the world, models, visuals, etc.
    -->
        <model name="cube2">
            <pose>0 0 0 0 0 0</pose>
            <link name="polyLine2">
                <inertial>
                <pose>0.5 0.5 0.75 0 0 0</pose>
                </inertial>
                <collision name="polyLine2Col">
                <geometry>
                    <polyline>
                    <point>0 0</point>
                    <point>0 1</point>
                    <point>1 1</point>
                    <point>1 0 </point>
                    <height>1.5</height>
                    </polyline>
                </geometry>
                </collision>

                <visual name="polyLine2Geom">
                <geometry>
                    <polyline>
                    <point>0 0</point>
                    <point>0 1</point>
                    <point>1 1</point>
                    <point>1 0 </point>
                    <height>1.5</height>
                    </polyline>
                </geometry>
                <material>
                    <ambient>1.0 1.0 0 1</ambient>
                    <diffuse>1.0 1.0 0 1</diffuse>
                    <specular>1.0 1.0 0 1</specular>
                </material>
                </visual>
            </link>
        </model>
    <plugin filename="TouchSensor" name="touch_sensor::TouchSensor">
    </plugin>
  </world>
</sdf>